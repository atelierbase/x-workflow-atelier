# 絶対に Git にコミットしない（API key 漏洩防止）
x-credentials.json
*-credentials.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# 実行ログ（大きくなりすぎる場合があるので、analytics/scheduler.log は手動コミット）
storage/analytics/launchd_*.log

# Local controls for the user-authorized removal of former X posts
archive/2026-11-19-ai-account/x-public-posts-before-delete.json
archive/2026-11-19-ai-account/x-delete-results.json
archive/2026-11-19-ai-account/deletion-rate-limit.json
archive/2026-11-19-ai-account/x-timeline-after-delete.json
archive/2026-11-19-ai-account/x-account-after-delete.json
archive/2026-11-19-ai-account/local-ids-not-in-timeline.json
archive/2026-11-19-ai-account/x-search-coverage.json
archive/2026-11-19-ai-account/legacy-timeline.json
archive/2026-11-19-ai-account/x-delete-verification.json

# Full third-party post bodies are kept locally for analysis, not republished.
storage/research/*-raw.json

# Unpublished rejected image drafts remain local; current nine assets are tracked.
archive/2026-11-20-native-rejected-first-draft/*.png
archive/2026-11-20-native-rejected-first-draft/*.txt
